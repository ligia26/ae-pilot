# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local
#
# Corti credentials are OAuth2 client credentials (sent out-of-band).
# The tool exchanges them for a short-lived access token automatically.
CORTI_TENANT_NAME=base
CORTI_CLIENT_ID=
CORTI_CLIENT_SECRET=
CORTI_ENVIRONMENT=eu

# Recommended: refresh short-lived tokens automatically (the command must print only the token)
CORTI_TOKEN_CMD="sh scripts/get-token.sh"

# Alternatively, a ready-made bearer token / API key (used if no client credentials are set)
CORTI_API_KEY=

# Optional
# CORTI_MODEL=corti-s1
# AE_OWNER=jordan.lee

# Mock CRM server host/port (Node reads these via process.env)
CRM_PORT=3001
CRM_HOST=localhost
